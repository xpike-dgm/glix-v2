GLIX_ALLOWED_ORIGINS=https://glix.dgmcraft.online

# Web bildirimleri (isteğe bağlı). Anahtarları üret: node scripts/vapid-keys.mjs mailto:adresin@ornek.com
# Üçü de dolu değilse bildirim kapalıdır ve Ayarlar'da "Bildirimler" görünmez. Özel anahtarı paylaşma.
GLIX_VAPID_PUBLIC=
GLIX_VAPID_PRIVATE=
GLIX_VAPID_SUBJECT=

# Google ile giriş (isteğe bağlı). Kimlik ve sır birlikte verilir; GLIX_PUBLIC_URL de gerekir.
# Google Cloud'da "yetkili yönlendirme URI'si": https://glix.dgmcraft.online/api/auth/google/callback
GLIX_GOOGLE_CLIENT_ID=
GLIX_GOOGLE_CLIENT_SECRET=
GLIX_PUBLIC_URL=https://glix.dgmcraft.online

# E-posta (isteğe bağlı): Resend API anahtarı ve gönderen. İkisi de doluysa doğrulama ve şifre sıfırlama açılır (GLIX_PUBLIC_URL gerekir).
GLIX_RESEND_API_KEY=
GLIX_MAIL_FROM=GLIX <noreply@dgmcraft.online>

# Yönetici paneli (isteğe bağlı): /admin'e girebilecek hesapların sayısal kimlikleri, virgülle. Boşsa panel kapalıdır.
# Giriş kodu hesabın e-postasına gider; bu yüzden yukarıdaki e-posta ayarı da dolu olmalı. Bkz. docs/ADMIN.md
GLIX_ADMIN_ACCOUNT_IDS=

# Oyun sonu yorumu (isteğe bağlı): dil modeli servisinin (Anthropic) API anahtarı. Boşsa özellik tamamen kapalıdır.
GLIX_AI_KEY=

# Üretim Merkezi (isteğe bağlı): /api/uretim/* uçlarının anahtarı (uzun, rastgele; örn. `openssl rand -hex 32`).
# Boşsa uçlar kapalıdır (404). Uçlar yalnız sunucunun kendi ağından çağrılır; Caddy dışarıya 404 verir.
# Aynı değer Üretim Merkezi sitesine de verilir. Bkz. docs/uretim/SOZLESME.md bölüm 3.
GLIX_URETIM_TOKEN=
