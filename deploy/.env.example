GLIX_ALLOWED_ORIGINS=https://glix.dgmcraft.online

# Web bildirimleri (isteğe bağlı). Anahtarları üret: node scripts/vapid-keys.mjs mailto:adresin@ornek.com
# Üçü de dolu değilse bildirim kapalıdır ve Ayarlar'da "Bildirimler" görünmez. Özel anahtarı paylaşma.
GLIX_VAPID_PUBLIC=
GLIX_VAPID_PRIVATE=
GLIX_VAPID_SUBJECT=

# Google ile giriş (isteğe bağlı). Kimlik ve sır birlikte verilir; GLIX_PUBLIC_URL de gerekir.
# Google Cloud'da "yetkili yönlendirme URI'si": https://glix.dgmcraft.online/api/auth/google/callback
GLIX_GOOGLE_CLIENT_ID=
GLIX_GOOGLE_CLIENT_SECRET=
GLIX_PUBLIC_URL=https://glix.dgmcraft.online
